[{"concurrentRate": "0", "contentType": "", "header": "", "id": 1641879367378, "loginCheckJs": "", "loginUi": "", "loginUrl": "", "name": "1.参数调节方法\n  spd：语速调节，取值0-15，默认为5中语速\n  pit：音调调节，取值0-15，默认为5中语调\n  vol：音量调节，取值0-15，默认为5中音量\n\n2.引擎修复方法\n  ①改tts为tsn或改tsn为tts\n  ②修改pdt值,11,12,30,31,\n160,211,220,232,301\n\n3.搜狗语速调节\n  speaking_rate=1，默认值1,改大变快改小变慢，0.1调节，如0.9；1.1；1.2", "url": ""}, {"concurrentRate": "0", "contentType": "", "header": "", "id": 1641697053905, "loginCheckJs": "", "loginUi": "", "loginUrl": "", "name": "2.推荐 百度AI 情感杜逍遥", "url": "http://ai.baidu.com/aidemo?type=tns&spd=5&rate=32&pit=5&vol=15&dt=1&per=3&tex={{java.encodeURI(java.encodeURI(speakText))}}"}, {"concurrentRate": "0", "contentType": "", "header": "", "id": -11, "loginCheckJs": "", "loginUi": "", "loginUrl": "", "name": "2.推荐百度 PER5118 优美女声", "url": "http://tsn.baidu.com/text2audio,{\n    \"method\": \"POST\",\n    \"body\": \"tex={{java.encodeURI(java.encodeURI(speakText))}}&spd={{(speakSpeed + 5) / 10 + 4}}&per=5118&cuid=baidu_speech_demo&idx=1&cod=2&lan=zh&ctp=1&pdt=220&vol=10&aue=6&pit=5&_res_tag_=audio\"\n}"}, {"concurrentRate": "0", "contentType": "", "header": "", "id": 1617429726281, "loginCheckJs": "", "loginUi": "", "loginUrl": "", "name": "3.推荐 PER4126 百度温柔淑女", "url": "http://tts.baidu.com/text2audio,{\n    \"method\": \"POST\",\n    \"body\": \"tex={{java.encodeURI(java.encodeURI(speakText))}}&spd={{(speakSpeed + 5) / 10 + 3}}&per=4126&cuid=baidu_speech_demo&idx=1&cod=2&lan=zh&ctp=1&pdt=232&vol=10&aue=6&pit=7&_res_tag_=audio\"\n}"}, {"concurrentRate": "0", "contentType": "", "header": "", "id": 1629600575261, "loginCheckJs": "", "loginUi": "", "loginUrl": "", "name": "4.推荐 PER4114 AI百度评书", "url": "http://ai.baidu.com/aidemo?type=tns&spd=5&rate=32&pit=5&vol=15&dt=1&per=4114&tex={{java.encodeURI(java.encodeURI(speakText))}}"}]